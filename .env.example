# Settings for the account API (api/ and server/). The game itself needs none of them.
# Copy to .env.local for `vercel dev`; in production set them in the Vercel project.

# Postgres connection string, with sslmode=require for a hosted database.
# Without a database, pglite://.data/plonk keeps one in that folder. `vercel dev`
# starts a new process for every API request, so two requests at the same moment
# can collide on that folder (one fails; reload). A local Postgres does not have
# that limit: postgres://localhost/plonk
DATABASE_URL=pglite://.data/plonk

# Signs session cookies. 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Optional. The usernames of the accounts that may moderate (see reported maps
# and players, remove maps, ban players), separated by commas, in lower case.
# Left out or empty, nobody is a moderator. List only accounts that already
# exist: whoever registers a name listed here becomes a moderator.
MODERATORS=

# Optional. How many Google Street View viewers the site hands out in a UTC day
# before games fall back to open imagery. Left out or empty it is 150, about
# 4,650 a month against the 5,000 Google gives free. 0 hands out none. This is
# a courtesy limit for ordinary traffic; the hard stop is the quota cap in the
# Google Cloud console.
GOOGLE_VIEWERS_PER_DAY=
