{
  "name": "plonk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Free street-view guessing game on open imagery",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
